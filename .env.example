# Copy to .env (git-ignored). Docker Compose reads it automatically.
# Subnet(s) to sweep for bulbs: comma list of IPs, broadcast addresses, or CIDR subnets.
WIZ_TARGETS=192.168.2.0/24
# Host port for the web UI.
WEB_PORT=8080
# compose.prod.yaml only: image tag to run (latest, sha-<short>, or v1.2.3).
WIZ_VERSION=latest
